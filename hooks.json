{
  "sen-destructive-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
